{
  "Service": {
    "Name": "insights"
  },
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Messaging": {
    "QueueName": "insights-integration-tests"
  },
  "ServiceTokens": {
    "TokenEndpoint": "http://localhost:1/token",
    "ClientId": "healthyfac-insights",
    "ClientSecret": "unused-in-tests"
  },
  "Insights": {
    "Screening": {
      "BatchSize": 2
    },
    "Agent": {
      "RunDebounceSeconds": 30,
      "ProviderRetryDelaysSeconds": [ 10, 30, 90 ],
      "PlannerMaxIterations": 8,
      "PlannerHistoryMinutes": 30,
      "PlannerHistoryBucketCount": 120,
      "HistoryMaxRangeHours": 24,
      "ManualSearchChunks": 5,
      "OpenWorkOrderCount": 20,
      "EpisodeRangeHours": 24,
      "EpisodeCount": 50,
      "ExtractorMaxIterations": 10,
      "MaxConsecutiveErrors": 3,
      "RunLeaseSeconds": 300,
      "PollSeconds": 2,
      "IsWorkerEnabled": false
    }
  },
  "DocumentClient": {
    "GrpcAddress": "http://localhost:1"
  },
  "TelemetryClient": {
    "GrpcAddress": "http://localhost:1"
  },
  "CoreClient": {
    "GrpcAddress": "http://localhost:1"
  },
  "Docling": {
    "BaseUrl": "http://localhost:1",
    "ApiKey": "unused-in-tests"
  },
  "IdEncryption": {
    "Keys": [
      {
        "Prefix": "v1_",
        "Key": "dGVzdC1pZC1lbmNyeXB0aW9uLWtleS0zMmJ5dGVzISE=",
        "IsDefault": true
      }
    ]
  },
  "Gemini": {
    "ProjectId": "test-project",
    "Location": "test-location",
    "ChatModel": "test-chat-model",
    "TriageModel": "test-triage-model"
  }
}
