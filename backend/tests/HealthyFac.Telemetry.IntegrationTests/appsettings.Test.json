{
  "Service": {
    "Name": "telemetry"
  },
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Messaging": {
    "QueueName": "telemetry-integration-tests"
  },
  "Seeding": {
    "IsOptionalDataSeeded": false
  },
  "Telemetry": {
    "Detection": {
      "IsWorkerEnabled": false,
      "EvaluationIntervalSeconds": 10,
      "SettleLagSeconds": 5,
      "WarmUpSamples": 60,
      "SlowTauSeconds": 1800,
      "FastTauSeconds": 20,
      "DriftLimit": 3,
      "DriftResolveLimit": 2,
      "LevelTauSeconds": 30,
      "TrendTauSeconds": 60,
      "HorizonSeconds": 900,
      "NoiseGuardFactor": 3,
      "Persistence": 2,
      "GapSeconds": 600,
      "SigmaFloorShare": 0.01,
      "CatchUpBatchReadings": 10000,
      "SilenceLimitSeconds": 120,
      "PhaseDwellSeconds": 15,
      "UnknownModeDwellSeconds": 60,
      "SettleTimeSeconds": 30,
      "LeaseSeconds": 60,
      "HistoryBucketCap": 500
    }
  }
}
