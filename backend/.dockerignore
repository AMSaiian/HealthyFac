# Shared by every service image. The build context is the "backend" directory, so patterns are relative to it.
# A Dockerfile.dockerignore next to a Dockerfile replaces this file for that build. It does not merge.

# Secrets must never enter the build context.
**/.env
**/.env.*
!**/.env.example

# Build output and runtime files
**/bin/
**/obj/
**/out/
**/logs/
**/TestResults/

# Tooling and local state
.idea/
.vs/
**/*.user
**/*.suo

# Not needed by the image
tests/
**/*.md
