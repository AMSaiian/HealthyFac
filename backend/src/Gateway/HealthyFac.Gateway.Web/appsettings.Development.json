{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}"
        }
      }
    }
  },
  "Jwt": {
    "Issuer": "https://auth.healthyfac.test/realms/healthyfac",
    "MetadataAddress": "http://localhost:8081/realms/healthyfac/.well-known/openid-configuration",
    "IsHttpsMetadataRequired": false
  },
  "ReverseProxy": {
    "Routes": {
      "core": {
        "Match": {
          "Hosts": [
            "api.healthyfac.test"
          ]
        }
      },
      "core-invite-public": {
        "Match": {
          "Hosts": [
            "api.healthyfac.test"
          ]
        }
      },
      "keycloak-token": {
        "Match": {
          "Hosts": [
            "auth.healthyfac.test"
          ]
        }
      },
      "keycloak-realm": {
        "Match": {
          "Hosts": [
            "auth.healthyfac.test"
          ]
        }
      },
      "keycloak-resources": {
        "Match": {
          "Hosts": [
            "auth.healthyfac.test"
          ]
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.healthyfac.test:4200"
    ]
  }
}
