{
  "Service": {
    "Name": "gateway"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}{NewLine}{Exception}"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthEndpoints": {
    "Port": 8090
  },
  "Cors": {
    "IsEnabled": true,
    "AllowedOrigins": [],
    "IsCredentialsAllowed": false,
    "PreflightMaxAgeSeconds": 600
  },
  "Jwt": {
    "Audience": "healthyfac-core",
    "IsHttpsMetadataRequired": true
  },
  "OpenTelemetryLogging": {
    "IsEnabled": true,
    "Endpoint": ""
  },
  "Tracing": {
    "IsEnabled": true,
    "Endpoint": "",
    "SamplingRatio": 1,
    "AdditionalSources": []
  },
  "Metrics": {
    "IsEnabled": true,
    "Endpoint": "",
    "AdditionalMeters": []
  },
  "Proxy": {
    "IsEnabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "IsEveryProxyTrusted": false
  },
  "RateLimiting": {
    "Strict": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "BlobDownload": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "keycloak-token": {
        "ClusterId": "keycloak",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anonymous-strict",
        "Match": {
          "Path": "/realms/healthyfac/protocol/openid-connect/token",
          "Methods": [
            "POST",
            "OPTIONS"
          ]
        }
      },
      "core-invite-public": {
        "ClusterId": "core",
        "Order": 0,
        "CorsPolicy": "HealthyFacDefault",
        "RateLimiterPolicy": "anonymous-strict",
        "Match": {
          "Path": "/api/core/v1/employee-invites/{action:regex(^(verify|accept)$)}",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/core"
          },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api/core"
          }
        ],
        "AuthorizationPolicy": "anonymous"
      },
      "core": {
        "ClusterId": "core",
        "Order": 1,
        "CorsPolicy": "HealthyFacDefault",
        "RateLimiterPolicy": "default-limit",
        "Match": {
          "Path": "/api/core/{version:regex(^v[0-9]+([.][0-9]+)?$)}/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/core"
          },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api/core"
          }
        ],
        "AuthorizationPolicy": "authenticated"
      },
      "telemetry": {
        "ClusterId": "telemetry",
        "Order": 1,
        "CorsPolicy": "HealthyFacDefault",
        "RateLimiterPolicy": "default-limit",
        "Match": {
          "Path": "/api/telemetry/{version:regex(^v[0-9]+([.][0-9]+)?$)}/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/telemetry"
          },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api/telemetry"
          }
        ],
        "AuthorizationPolicy": "authenticated"
      },
      "document-blobs": {
        "ClusterId": "document-storage",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "blob-download",
        "Match": {
          "Path": "/api/document/blobs/{**path}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/document/blobs"
          },
          {
            "PathPrefix": "/devstoreaccount1"
          },
          {
            "RequestHeaderRemove": "Authorization"
          },
          {
            "RequestHeaderRemove": "Cookie"
          },
          {
            "ResponseHeader": "X-Content-Type-Options",
            "Set": "nosniff",
            "When": "Always"
          }
        ]
      },
      "document": {
        "ClusterId": "document",
        "Order": 1,
        "CorsPolicy": "HealthyFacDefault",
        "RateLimiterPolicy": "default-limit",
        "Match": {
          "Path": "/api/document/{version:regex(^v[0-9]+([.][0-9]+)?$)}/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/document"
          },
          {
            "X-Forwarded": "Set",
            "Prefix": "Off"
          },
          {
            "RequestHeader": "X-Forwarded-Prefix",
            "Set": "/api/document"
          }
        ],
        "AuthorizationPolicy": "authenticated",
        "MaxRequestBodySize": 105906176
      },
      "keycloak-realm": {
        "ClusterId": "keycloak",
        "Order": 2,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "default-limit",
        "Match": {
          "Path": "/realms/healthyfac/{**catch-all}"
        }
      },
      "keycloak-resources": {
        "ClusterId": "keycloak",
        "Order": 2,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "default-limit",
        "Match": {
          "Path": "/resources/{**catch-all}"
        }
      },
      "spa": {
        "ClusterId": "spa",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "default-limit",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "core": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOnly",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "main": {
            "Address": "http://localhost:8080/",
            "Health": "http://localhost:8091/"
          }
        }
      },
      "telemetry": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOnly",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "main": {
            "Address": "http://localhost:8083/",
            "Health": "http://localhost:8094/"
          }
        }
      },
      "document": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOnly",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "main": {
            "Address": "http://localhost:8085/",
            "Health": "http://localhost:8096/"
          }
        }
      },
      "document-storage": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "main": {
            "Address": "http://localhost:10000/"
          }
        }
      },
      "keycloak": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "main": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "spa": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOnly",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "main": {
            "Address": "http://localhost:8082/",
            "Health": "http://localhost:8093/"
          }
        }
      }
    }
  }
}
