{
  "ConnectionStrings": {
    "CoreDatabase": "Host=localhost;Port=5432;Database=healthyfac_core;Username=postgres;Options=-c default_transaction_read_only=on",
    "TelemetryDatabase": "Host=localhost;Port=5432;Database=healthyfac_telemetry;Username=postgres;Options=-c default_transaction_read_only=on"
  },
  "Mqtt": {
    "Host": "localhost",
    "Username": "sender"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    }
  }
}
