<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\HealthyFac.MachineSimulator.Scenarios\HealthyFac.MachineSimulator.Scenarios.csproj"/>
        <ProjectReference Include="..\..\Core\HealthyFac.Core.Infrastructure\HealthyFac.Core.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\Telemetry\HealthyFac.Telemetry.Infrastructure\HealthyFac.Telemetry.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\Document\HealthyFac.Document.Infrastructure\HealthyFac.Document.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\Insights\HealthyFac.Insights.Infrastructure\HealthyFac.Insights.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\Auth\HealthyFac.Auth.Infrastructure\HealthyFac.Auth.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\seed\demo\*.json" Link="seed\demo\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\..\seed\demo\ingest\*.json" Link="seed\demo\ingest\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\..\seed\demo\files\*" Link="seed\demo\files\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Core\HealthyFac.Core.Web\appsettings.json" Link="services\core\appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Telemetry\HealthyFac.Telemetry.Web\appsettings.json" Link="services\telemetry\appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Document\HealthyFac.Document.Web\appsettings.json" Link="services\document\appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Insights\HealthyFac.Insights.Web\appsettings.json" Link="services\insights\appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Auth\HealthyFac.Auth.Web\appsettings.json" Link="services\auth\appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Core\HealthyFac.Core.Web\appsettings.Development.json" Link="services\core\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Telemetry\HealthyFac.Telemetry.Web\appsettings.Development.json" Link="services\telemetry\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Document\HealthyFac.Document.Web\appsettings.Development.json" Link="services\document\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Insights\HealthyFac.Insights.Web\appsettings.Development.json" Link="services\insights\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\Auth\HealthyFac.Auth.Web\appsettings.Development.json" Link="services\auth\appsettings.Development.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HealthyFac.Seeder.UnitTests"/>
        <InternalsVisibleTo Include="HealthyFac.Seeder.IntegrationTests"/>
        <InternalsVisibleTo Include="HealthyFac.Seeder.ArchitectureTests"/>
    </ItemGroup>

</Project>
