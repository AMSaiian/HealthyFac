{
  "Service": {
    "Name": "auth"
  },
  "Messaging": {
    "QueueName": "auth"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/auth-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthEndpoints": {
    "Port": 8090
  },
  "OpenTelemetryLogging": {
    "IsEnabled": true,
    "Endpoint": ""
  },
  "Tracing": {
    "IsEnabled": true,
    "Endpoint": "",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql"
    ]
  },
  "Metrics": {
    "IsEnabled": true,
    "Endpoint": "",
    "AdditionalMeters": [
      "Npgsql"
    ]
  },
  "Jwt": {
    "Audience": "healthyfac-auth",
    "IsHttpsMetadataRequired": true
  },
  "Proxy": {
    "IsEnabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "IsEveryProxyTrusted": false
  },
  "Cors": {
    "IsEnabled": false,
    "AllowedOrigins": [],
    "IsCredentialsAllowed": false
  },
  "Https": {
    "IsRedirectEnabled": false,
    "RedirectPort": null,
    "IsHstsEnabled": true,
    "HstsMaxAgeDays": 365,
    "IsHstsSubDomainsIncluded": true,
    "IsHstsPreloaded": false
  }
}
