{
  "Service": {
    "Name": "auth"
  },
  "Messaging": {
    "QueueName": "auth"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/auth-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "HealthyFac.Auth"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthEndpoints": {
    "Port": 8090
  },
  "OpenTelemetryLogging": {
    "Enabled": true,
    "Endpoint": "",
    "ServiceName": "HealthyFac.Auth"
  },
  "Tracing": {
    "Enabled": true,
    "Endpoint": "",
    "ServiceName": "HealthyFac.Auth",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql"
    ]
  }
}
