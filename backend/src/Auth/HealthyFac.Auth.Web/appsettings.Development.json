{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetryLogging": {
    "IsEnabled": true,
    "Endpoint": ""
  },
  "Tracing": {
    "IsEnabled": true,
    "Endpoint": "",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql"
    ]
  },
  "Metrics": {
    "IsEnabled": true,
    "Endpoint": "",
    "AdditionalMeters": [
      "Npgsql"
    ]
  }
}
