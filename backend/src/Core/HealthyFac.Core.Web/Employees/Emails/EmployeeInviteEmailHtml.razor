<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #F4F4F4; padding: 24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #FFFFFF; font-family: Arial, Helvetica, sans-serif; color: #222222;">
        <tr>
          <td style="padding: 32px;">
            <h1 style="margin: 0 0 16px 0; font-size: 22px;">@RazorEmployeeInviteEmailBuilder.Subject</h1>
            <p style="margin: 0 0 24px 0; font-size: 16px; line-height: 24px;">Open the link to set up your account.</p>
            <p style="margin: 0 0 24px 0;">
              <a href="@Model.Link" style="display: inline-block; padding: 12px 24px; background-color: #1F6FEB; color: #FFFFFF; text-decoration: none; border-radius: 4px;">Set up your account</a>
            </p>
            <p style="margin: 0 0 16px 0; font-size: 14px; line-height: 20px;">
              If the button does not work, copy this link into your browser:<br />
              <a href="@Model.Link" style="color: #1F6FEB; word-break: break-all;">@Model.Link</a>
            </p>
            <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 20px;">The link works until @EmployeeInviteEmailFormat.Expiry(Model.ExpiresAt).</p>
            <p style="margin: 0; font-size: 14px; line-height: 20px; color: #666666;">If you did not expect this email, ignore it.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

@code {
  [Parameter, EditorRequired]
  public required EmployeeInviteEmailModel Model { get; set; }
}
