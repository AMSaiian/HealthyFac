{
  "Seeding": {
    "SeedOptionalData": true
  },
  "Jwt": {
    "Issuer": "https://auth.healthyfac.test/realms/healthyfac",
    "MetadataAddress": "http://localhost:8081/realms/healthyfac/.well-known/openid-configuration",
    "IsHttpsMetadataRequired": false
  },
  "InviteLinks": {
    "SpaBaseUrl": "https://app.healthyfac.test:4200"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@healthyfac.local",
    "FromName": "HealthyFac"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "HealthyFac.Core"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetryLogging": {
    "Enabled": true,
    "Endpoint": "",
    "ServiceName": "HealthyFac.Core"
  },
  "Tracing": {
    "Enabled": true,
    "Endpoint": "",
    "ServiceName": "HealthyFac.Core",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql"
    ]
  },
  "Proxy": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "TrustAllProxies": false
  },
  "Cors": {
    "Enabled": false
  },
  "Https": {
    "RedirectEnabled": false,
    "RedirectPort": null,
    "HstsEnabled": false,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  }
}
