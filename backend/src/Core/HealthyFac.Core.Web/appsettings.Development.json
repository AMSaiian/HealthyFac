{
  "Seeding": {
    "SeedOptionalData": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "HealthyFac.Core"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetryLogging": {
    "Enabled": true,
    "Endpoint": "",
    "ServiceName": "HealthyFac.Core"
  },
  "Tracing": {
    "Enabled": true,
    "Endpoint": "",
    "ServiceName": "HealthyFac.Core",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql"
    ]
  },
  "Proxy": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "TrustAllProxies": false
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ],
    "AllowCredentials": false
  },
  "Https": {
    "RedirectEnabled": false,
    "RedirectPort": null,
    "HstsEnabled": false,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  }
}
