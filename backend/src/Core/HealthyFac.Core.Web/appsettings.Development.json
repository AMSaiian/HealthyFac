{
  "Seeding": {
    "IsOptionalDataSeeded": true
  },
  "IdEncryption": {
    "Keys": [
      {
        "Prefix": "v1.",
        "IsDefault": true
      }
    ]
  },
  "InviteTokens": {
    "Keys": [
      {
        "Id": "k1",
        "IsDefault": true
      }
    ]
  },
  "Jwt": {
    "Issuer": "https://auth.healthyfac.test/realms/healthyfac",
    "MetadataAddress": "http://localhost:8081/realms/healthyfac/.well-known/openid-configuration",
    "IsHttpsMetadataRequired": false
  },
  "InviteLinks": {
    "SpaBaseUrl": "https://app.healthyfac.test:4200"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@healthyfac.local",
    "FromName": "HealthyFac"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetryLogging": {
    "IsEnabled": true,
    "Endpoint": ""
  },
  "Tracing": {
    "IsEnabled": true,
    "Endpoint": "",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql"
    ]
  },
  "Metrics": {
    "IsEnabled": true,
    "Endpoint": "",
    "AdditionalMeters": [
      "Npgsql"
    ]
  },
  "Proxy": {
    "IsEnabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "IsEveryProxyTrusted": false
  },
  "Cors": {
    "IsEnabled": false
  },
  "Https": {
    "IsRedirectEnabled": false,
    "RedirectPort": null,
    "IsHstsEnabled": false,
    "HstsMaxAgeDays": 365,
    "IsHstsSubDomainsIncluded": true,
    "IsHstsPreloaded": false
  }
}
