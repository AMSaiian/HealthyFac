{
  "Seeding": {
    "IsOptionalDataSeeded": true
  },
  "Jwt": {
    "Issuer": "https://auth.healthyfac.test/realms/healthyfac",
    "MetadataAddress": "http://localhost:8081/realms/healthyfac/.well-known/openid-configuration",
    "IsHttpsMetadataRequired": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}/{SpanId}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetryLogging": {
    "IsEnabled": true,
    "Endpoint": ""
  },
  "Tracing": {
    "IsEnabled": true,
    "Endpoint": "",
    "SamplingRatio": 1,
    "AdditionalSources": [
      "Npgsql",
      "HealthyFac.Document.Files"
    ]
  },
  "Metrics": {
    "IsEnabled": true,
    "Endpoint": "",
    "AdditionalMeters": [
      "Npgsql"
    ]
  },
  "Proxy": {
    "IsEnabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "IsEveryProxyTrusted": false
  },
  "Cors": {
    "IsEnabled": false
  },
  "Https": {
    "IsRedirectEnabled": false,
    "RedirectPort": null,
    "IsHstsEnabled": false,
    "HstsMaxAgeDays": 365,
    "IsHstsSubDomainsIncluded": true,
    "IsHstsPreloaded": false
  },
  "FileStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;",
    "PublicBlobBaseUrl": "https://api.healthyfac.test/api/document/blobs"
  }
}
