{
  "Service": {
    "Name": "spa"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}> {TraceId}{NewLine}{Exception}"
        }
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthEndpoints": {
    "Port": 8090
  },
  "OpenTelemetryLogging": {
    "IsEnabled": true,
    "Endpoint": ""
  },
  "Tracing": {
    "IsEnabled": true,
    "Endpoint": "",
    "SamplingRatio": 1,
    "AdditionalSources": []
  },
  "Metrics": {
    "IsEnabled": true,
    "Endpoint": "",
    "AdditionalMeters": []
  },
  "Proxy": {
    "IsEnabled": true,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "IsEveryProxyTrusted": false
  },
  "Spa": {
    "ContentRoot": "wwwroot",
    "AuthRealm": "healthyfac",
    "AuthClientId": "healthyfac-spa",
    "HashedFileNamePattern": "-[A-Z0-9]{8}\\.",
    "ImmutableCacheSeconds": 31536000,
    "RuntimeConfigCacheSeconds": 300,
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=()"
  }
}
