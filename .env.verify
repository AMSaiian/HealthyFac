# Overrides of the isolated verify stack. scripts/verify-stack.ps1 passes .env first and this file second, so these
# values replace the dev values for the projects healthyfac-verify-<slot> only. The file holds no secrets: the secrets come
# from .env. Commit it.
#
# The slot values are not here. scripts/verify-stack.ps1 picks the slot of the worktree (1-4) and sets
# HEALTHYFAC_DOMAIN (s<slot>.hfverify.test), GATEWAY_PORT (9443 + slot), MAILPIT_UI_PORT (8026 + slot), GRAFANA_PORT (3000 + slot),
# RABBITMQ_MANAGEMENT_PORT (15672 + slot), and KEYCLOAK_PORT (8180 + slot) in the
# process environment, which Compose reads before this file. Browser cookies ignore the port, so every slot has its own
# domain. Add this line to C:\Windows\System32\drivers\etc\hosts once, as an administrator:
#   127.0.0.1 api.s1.hfverify.test auth.s1.hfverify.test app.s1.hfverify.test api.s2.hfverify.test auth.s2.hfverify.test app.s2.hfverify.test api.s3.hfverify.test auth.s3.hfverify.test app.s3.hfverify.test api.s4.hfverify.test auth.s4.hfverify.test app.s4.hfverify.test

# The public URLs carry the gateway port, because it is not 443 (see .env.example).
HEALTHYFAC_AUTH_URL="https://auth.${HEALTHYFAC_DOMAIN}:${GATEWAY_PORT}"
HEALTHYFAC_API_URL="https://api.${HEALTHYFAC_DOMAIN}:${GATEWAY_PORT}"
HEALTHYFAC_SPA_URL="https://app.${HEALTHYFAC_DOMAIN}:${GATEWAY_PORT}"

# A verify run starts from a fresh database, so the seed never needs a forced recreation.
HEALTHYFAC_SEED_RECREATE=false
