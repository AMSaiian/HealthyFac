# Overrides of the isolated verify stack. scripts/verify-stack.ps1 passes .env first and this file second, so these
# values replace the dev values for the project healthyfac-verify only. The file holds no secrets: the secrets come
# from .env. Commit it.
#
# Own domain: browser cookies ignore the port, so a second Keycloak on auth.healthyfac.test would overwrite the dev
# sign-in. Add this line to C:\Windows\System32\drivers\etc\hosts once, as an administrator:
#   127.0.0.1 api.hfverify.test auth.hfverify.test app.hfverify.test
HEALTHYFAC_DOMAIN=hfverify.test

# Published host ports. They must differ from the dev ports in .env, because both stacks run at the same time.
# docker/verify/docker-compose.verify.yml publishes only these two; every other service has no host port.
GATEWAY_PORT=9443
MAILPIT_UI_PORT=8026

# The public URLs carry the gateway port, because it is not 443 (see .env.example).
HEALTHYFAC_AUTH_URL="https://auth.${HEALTHYFAC_DOMAIN}:${GATEWAY_PORT}"
HEALTHYFAC_API_URL="https://api.${HEALTHYFAC_DOMAIN}:${GATEWAY_PORT}"
HEALTHYFAC_SPA_URL="https://app.${HEALTHYFAC_DOMAIN}:${GATEWAY_PORT}"

# A verify run starts from a fresh database, so the seed never needs a forced recreation.
HEALTHYFAC_SEED_RECREATE=false
