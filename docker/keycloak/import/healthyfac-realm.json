  "roles": {
    "realm": [
      {
        "name": "supervisor",
        "description": "Group of the permissions of a supervisor",
        "composite": true,
        "composites": {
          "client": {
            "healthyfac-core": [
              "employees:invite",
              "employees:manage",
              "machines:write"
            ]
          }
        }
      },
      {
        "name": "worker",
        "description": "Group of the permissions of a worker. It holds no permission yet."
      }
    ],
    "client": {
      "healthyfac-core": [
        {
          "name": "employees:invite",
          "description": "Invite and re-invite employees"
        },
        {
          "name": "employees:manage",
          "description": "Retry provisioning and deactivate employees"
        },
        {
          "name": "machines:write",
          "description": "Create and change machines"
