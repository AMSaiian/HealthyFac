# Copy this file to .env and fill in real values. Never commit .env.
# This file holds only secrets and the values of this machine (ports, names, paths, switches). A fixed value that
# is no secret belongs in an appsettings file: appsettings.json (every environment), appsettings.Development.json
# (a run on the host), or docker/config/<service>.json (the Compose network). See docker/config/README.md.
# ASP.NET Core maps "__" in an environment variable name to a configuration section separator. A key with "__"
# below is read by a service that runs on the host; Compose sets its own value for each container.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL connection string for the core service.
ConnectionStrings__Database=Host=localhost;Database=healthyfac_core_dev;Username=postgres;Password=CHANGE_ME

# The identifier encryption key: a base64 encoded 256-bit value. Generate one with: openssl rand -base64 32
# Its prefix (v1.) and its default flag are in appsettings.Development.json of each service.
IdEncryption__Keys__0__Key=CHANGE_ME_BASE64_32_BYTES

# The invite token secret: a base64 encoded value of at least 32 bytes. Generate one with: openssl rand -base64 32
# Its ID (k1) and its default flag are in appsettings.Development.json of Core. The lifetime is 72 hours by default;
# set InviteTokens:LifetimeHours in an appsettings file to change it.
InviteTokens__Keys__0__Secret=CHANGE_ME_BASE64_32_BYTES

# Set to true to run optional seed data on startup.
Seeding__IsOptionalDataSeeded=false

# true deletes the Core business data, outbox, and inbox, and seeds again on every start. Set it back to false after
# one start.
HEALTHYFAC_SEED_RECREATE=false

# OpenTelemetry endpoints for an app that runs on the host. Compose sets in-network values for each service.
# Traces and metrics use OTLP over gRPC. Logs use OTLP over HTTP and need the full /v1/logs path.
# Leave empty to keep spans, metrics, and logs in process.
Tracing__Endpoint=http://localhost:4317
Metrics__Endpoint=http://localhost:4317
OpenTelemetryLogging__Endpoint=http://localhost:4318/v1/logs

# PostgreSQL container credentials. Compose reads these for the postgres and keycloak services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=healthyfac_core

# Keycloak. The admin account is created on first start only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB=keycloak

# The public domain. Services answer the names api.<domain> (Core API), auth.<domain> (Keycloak), and app.<domain>
# (web app). Add these lines to the hosts file (C:\Windows\System32\drivers\etc\hosts on Windows) as an administrator:
#   127.0.0.1 api.healthyfac.test auth.healthyfac.test app.healthyfac.test
# The domain .test is reserved for tests (RFC 6761) and never resolves on the internet.
HEALTHYFAC_DOMAIN=healthyfac.test

# The public URL of Keycloak through the gateway. The issuer of every token is {HEALTHYFAC_AUTH_URL}/realms/healthyfac.
# The gateway ends TLS (see docker/certs). Add :<GATEWAY_PORT> when GATEWAY_PORT is not 443, because the issuer must
# equal the URL that the browser uses.
HEALTHYFAC_AUTH_URL=https://auth.healthyfac.test

# Development realm import and test tenant. The keycloak-config job replaces the placeholders of docker/keycloak/realm/healthyfac-realm.json and docker/keycloak/dev/healthyfac-test-tenant.json
# with these values, and Core seeds the same company and supervisor from them (Seeding__DevelopmentData__TestTenant__*,
# plus the names in backend/seed/seed.Development.json).
# Use new GUIDs. The password needs at least 12 characters and must differ from the email.
# The import skips an existing realm. After you change a value, run `docker compose down -v` to reset the stack.
# The address of the web app. Redirect URIs, the CORS origin, and the invite email link use it: the email links to
# {HEALTHYFAC_SPA_URL}/invite#token=... Compose passes it to Core as InviteLinks__SpaBaseUrl.
HEALTHYFAC_SPA_URL=https://app.healthyfac.test:4200
# Two run modes for the web app. "ng serve" (frontend/) keeps the default above. The container mode (the spa service)
# serves https://app.healthyfac.test through the gateway: set HEALTHYFAC_SPA_URL=https://app.healthyfac.test for it.
# The public URL of the API through the gateway. The spa service sends it to the browser in /config.json.
# Add :<GATEWAY_PORT> when GATEWAY_PORT is not 443.
HEALTHYFAC_API_URL=https://api.healthyfac.test
HEALTHYFAC_TEST_COMPANY_ID=CHANGE_ME_GUID
HEALTHYFAC_TEST_SUPERVISOR_IDENTITY_ID=CHANGE_ME_GUID
HEALTHYFAC_TEST_SUPERVISOR_EMPLOYEE_ID=CHANGE_ME_GUID
HEALTHYFAC_TEST_SUPERVISOR_EMAIL=supervisor@healthyfac.local
HEALTHYFAC_TEST_SUPERVISOR_PASSWORD=CHANGE_ME_MIN_12_CHARS
# The test worker (worker@healthyfac.local, fixed IDs in backend/seed/seed.Development.json and
# docker/keycloak/dev/healthyfac-test-tenant.json) signs in with the same password as the supervisor.
# Compose passes the values above to Core as Seeding__DevelopmentData__TestTenant__*. The company name, its time
# zone, the supervisor name, and the seed machines are not here: they live in backend/seed/seed.Development.json,
# which Core reads in Development. An app that runs on the host seeds the test tenant only when you set the four
# keys CompanyId, SupervisorIdentityId, SupervisorEmployeeId, and SupervisorEmail under that prefix.
# Secret of the healthyfac-auth client. Session 6 uses it for the Auth service.
KEYCLOAK_AUTH_CLIENT_SECRET=CHANGE_ME
# Secret of the healthyfac-core client. Keycloak uses it when Core exchanges a user token for another service.
KEYCLOAK_CORE_CLIENT_SECRET=CHANGE_ME
# Secret of the healthyfac-telemetry client. Keycloak uses it when Telemetry exchanges a user token for another service.
KEYCLOAK_TELEMETRY_CLIENT_SECRET=CHANGE_ME
# Secret of the healthyfac-document client (the confidential API client of the Document service).
KEYCLOAK_DOCUMENT_CLIENT_SECRET=CHANGE_ME
# Secret of the healthyfac-insights client (the confidential API client and service account of the Insights service).
KEYCLOAK_INSIGHTS_CLIENT_SECRET=CHANGE_ME

# Insights: Vertex AI (Gemini) and Docling. Insights reads your Application Default Credentials file through a
# read-only mount. Run "gcloud auth application-default login" once. The file is in
#   Windows: ${APPDATA}/gcloud/application_default_credentials.json
#   Linux and macOS: ~/.config/gcloud/application_default_credentials.json
# Keep the value a path (with a slash): Compose reads a bare word as a volume name and rejects the file.
GCLOUD_ADC_FILE=./CHANGE_ME/application_default_credentials.json
GEMINI_PROJECT_ID=CHANGE_ME
GEMINI_LOCATION=CHANGE_ME
GEMINI_CHAT_MODEL=CHANGE_ME
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# The API key that Insights sends to Docling in the X-Api-Key header.
DOCLING_API_KEY=CHANGE_ME

# Mosquitto (the broker for the machine messages). Telemetry reads with the user "telemetry"; a gateway or a test writes
# with the user "sender". Use different passwords. The mosquitto-init job hashes them into the data volume at each start.
MOSQUITTO_TELEMETRY_PASSWORD=CHANGE_ME
MOSQUITTO_SENDER_PASSWORD=CHANGE_ME

# Redis. The password protects the rate limiter counters. Compose requires it.
REDIS_PASSWORD=CHANGE_ME

# Redis connection string for an app that runs on the host. Compose sets an in-network value for the gateway.
Redis__ConnectionString=localhost:6379,password=CHANGE_ME

# RabbitMQ. Compose creates the broker user from RABBITMQ_USER and RABBITMQ_PASSWORD and requires both.
# Use a password without URL special characters, because the connection string below is a URI.
# Core builds the same URI inside Compose. The input queue name of each service is in its appsettings.json.
RABBITMQ_USER=healthyfac
RABBITMQ_PASSWORD=CHANGE_ME
ConnectionStrings__RabbitMq=amqp://healthyfac:CHANGE_ME@localhost:5672

# Console debugging on a running environment. Set these on the core service, then restart it:
#   Serilog__WriteTo__Console__Args__restrictedToMinimumLevel=Information
#   Serilog__MinimumLevel__Default=Debug
# The file sink keeps Information and above in logs/core-.log, as compact JSON, for 14 days.

# Mailpit catches all email in development. The web UI shows the messages at http://localhost:8025.
# Core sends email to the SMTP port of Mailpit: docker/config/core.json holds the host, the port, and the security
# mode for Compose, and appsettings.Development.json holds them and the sender address for a run on the host.
# Another deployment sets the Smtp section of the real mail server in its own settings file, and its password as
# a secret.

# PrimeUI Community license key. The SPA host sends it to the browser in /config.json. Never commit it.
PRIMEUI_LICENSE_KEY=CHANGE_ME

# Host port mappings. Change these when a port is already taken on your machine.
# The health ports (CORE_HEALTH_PORT, TELEMETRY_HEALTH_PORT, DOCUMENT_HEALTH_PORT, INSIGHTS_HEALTH_PORT, AUTH_HEALTH_PORT, GATEWAY_HEALTH_PORT, SPA_HEALTH_PORT) bind to 127.0.0.1 only and serve
# /health, /health/ready, and /hc. The container ports stay fixed: Postgres 5432, Keycloak 8080, Core 8080 and 8090, Telemetry 8080 and 8090, Document 8080 and 8090 (gRPC 8081, not published), Insights 8080 and 8090, Docling 5001, Azurite 10000,
# Auth 8090, Gateway 8080 and 8090, SPA host 8080 and 8090, Redis 6379, RabbitMQ 5672 and 15672, Grafana 3000, OTLP 4317 and 4318, Mailpit 8025 and 1025.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8081
CORE_PORT=8080
CORE_HEALTH_PORT=8091
TELEMETRY_PORT=8083
# The MQTT port of Mosquitto, for the machine messages.
MOSQUITTO_PORT=1883
TELEMETRY_HEALTH_PORT=8094
DOCUMENT_PORT=8085
DOCUMENT_HEALTH_PORT=8096
INSIGHTS_PORT=8087
INSIGHTS_HEALTH_PORT=8097
DOCLING_PORT=5001
# The blob port of Azurite (the file storage emulator). It binds to 127.0.0.1 only.
AZURITE_BLOB_PORT=10000
AUTH_HEALTH_PORT=8092
# The HTTPS port of the gateway. HEALTHYFAC_AUTH_URL has no port, so keep 443 or add the port to that URL.
GATEWAY_PORT=443
GATEWAY_HEALTH_PORT=8090
SPA_HEALTH_PORT=8093
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# The isolated verify stack (scripts/verify-stack.ps1) reads this file and then .env.verify, which overrides the
# domain, the public URLs, and the published ports, so it runs next to the dev stack.
