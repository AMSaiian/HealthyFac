# Copy this file to .env and fill in real values. Never commit .env.
# ASP.NET Core maps "__" in an environment variable name to a configuration section separator.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL connection string for the core service.
ConnectionStrings__Database=Host=localhost;Database=healthyfac_core_dev;Username=postgres;Password=CHANGE_ME

# Identifier encryption keys. Each key needs a unique prefix and a base64 encoded 256-bit value.
# Generate one with: openssl rand -base64 32
IdEncryption__Keys__0__Prefix=v1.
IdEncryption__Keys__0__Key=CHANGE_ME_BASE64_32_BYTES
IdEncryption__Keys__0__Default=true

# Set to true to run optional seed data on startup.
Seeding__SeedOptionalData=false

# OpenTelemetry endpoints for an app that runs on the host. Compose sets in-network values for core.
# Traces use OTLP over gRPC. Logs use OTLP over HTTP and need the full /v1/logs path.
# Leave empty to keep spans and logs in process.
Tracing__Endpoint=http://localhost:4317
OpenTelemetryLogging__Endpoint=http://localhost:4318/v1/logs

# PostgreSQL container credentials. Compose reads these for the postgres and keycloak services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=healthyfac_core

# Keycloak. The admin account is created on first start only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB=keycloak

# Console debugging on a running environment. Set these on the core service, then restart it:
#   Serilog__WriteTo__Console__Args__restrictedToMinimumLevel=Information
#   Serilog__MinimumLevel__Default=Debug
# The file sink keeps Information and above in logs/core-.log, as compact JSON, for 14 days.

# Host port mappings. Change these when a port is already taken on your machine.
# The container ports stay fixed: Postgres 5432, Keycloak 8080, Core 8080, Grafana 3000, OTLP 4317 and 4318.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8081
CORE_PORT=8080
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
